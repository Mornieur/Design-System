# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
.npmrc
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.lighthouseci/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/tmp-dev-*.log
/tmp-next-dev-*.log
/.tmp-next-stdout.log
/.tmp-next-stderr.log
/test-results/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!consumer-tests/next-app-router/next-env.d.ts

*storybook.log
storybook-static
feitoza-ui-core-*.tgz
consumer-tests/**/node_modules
consumer-tests/**/dist
consumer-tests/**/.next
consumer-tests/**/.turbo
consumer-tests/**/package-lock.json
